{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cell-quest.local/schema/case-pack-v1.json",
  "title": "Cell Quest Case Content Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "name", "gameVersion", "reviewedAt", "disclaimer", "cases", "sources"],
  "properties": {
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "gameVersion": { "type": "string", "pattern": "^>=\\d+\\.\\d+\\.\\d+$" },
    "reviewedAt": { "type": "string", "format": "date" },
    "disclaimer": { "type": "string", "minLength": 1, "maxLength": 120 },
    "cases": { "type": "array", "minItems": 1, "maxItems": 50 },
    "sources": { "type": "array", "minItems": 1, "maxItems": 100 }
  }
}
